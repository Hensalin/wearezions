.zpods__bar input{width:min(100%,420px);font:inherit;font-size:16px;padding:12px 4px;border:0;border-bottom:1px solid currentColor;background:transparent;color:inherit;border-radius:0}
.zpods__bar input:focus{outline:0;border-color:#c9a24b}
.zeps{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:clamp(18px,2vw,30px)}
.zep{display:flex;flex-direction:column;gap:8px;color:inherit;text-decoration:none}
.zep__img{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;border-radius:6px;background:linear-gradient(135deg,#2a2218,#6b5320)}
.zep__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .9s cubic-bezier(.16,1,.3,1)}
.zep:hover .zep__img img{transform:scale(1.06)}
.zep__img em{position:absolute;top:12px;left:12px;background:#fff;color:#14110d;font-style:normal;font-size:13px;padding:6px 12px;border-radius:4px}
.zep__img i{position:absolute;right:12px;bottom:12px;width:44px;height:44px;border-radius:50%;background:#c9a24b;color:#14110d;display:grid;place-items:center;font-size:22px;opacity:0;transform:translateY(8px);transition:.35s}
.zep:hover .zep__img i{opacity:1;transform:none}
.zep h3{font-size:16px;font-weight:600;line-height:1.3;margin:4px 0 0;text-transform:none;font-family:var(--f-body)}
.zep__m{font-size:13px;opacity:.65}
#podMore{border:0;cursor:pointer;font:inherit}
@media(max-width:800px){.zpodh__in{grid-template-columns:1fr}.zpodh__art{max-width:300px}}

/* Navbar menu: slightly larger text */
header.nav nav.nav__links a,header.nav nav.nav__links .nav__more>button,header.nav a.nav__cta{font-size:15px!important}
header.nav nav.nav__links{gap:clamp(14px,1.6vw,26px)}
@media(min-width:901px){header.nav{width:min(1060px,calc(100% - 28px))!important}}
header.nav nav.nav__links a,header.nav nav.nav__links .nav__more>button{font-weight:600!important}
header.nav a.nav__cta{font-weight:700!important}

/* Give: marquee band */
.zmarq{overflow:hidden;padding:clamp(24px,4vw,56px) 0;display:flex;flex-direction:column;gap:6px;background:#0b0b0c;color:#f4ece0}
.zmarq__t{display:flex;gap:.5em;white-space:nowrap;width:max-content;font-family:var(--f-display);text-transform:uppercase;font-size:clamp(46px,8vw,128px);line-height:1}
.zmarq__t span{-webkit-text-stroke:0}
.zmarq__t:nth-child(2) span{color:transparent;-webkit-text-stroke:1.5px #c9a24b}
.zmarq__t i{font-style:normal;color:#c9a24b;font-size:.5em;align-self:center}

/* Events */
.zev__feat{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(24px,5vw,80px);align-items:center}
.zev__facts{list-style:none;margin:1.2em 0;padding:0;display:flex;flex-direction:column;gap:12px;font-size:var(--z-body)}
.zev__facts li{display:flex;gap:12px;align-items:flex-start}.zev__facts i{color:#c9a24b;margin-top:.2em}
.zev__cover{margin:0;aspect-ratio:4/5;overflow:hidden;border-radius:var(--z-r-lg)}
.zev__cover img{width:100%;height:100%;object-fit:cover;display:block}
.zev__grid{columns:4 240px;column-gap:clamp(10px,1.2vw,18px);margin-top:1.6em}
.zev__t{display:block;width:100%;padding:0;margin:0 0 clamp(10px,1.2vw,18px);border:0;background:rgba(127,127,127,.18);border-radius:var(--z-r-md);overflow:hidden;cursor:zoom-in;break-inside:avoid}
.zev__t img{width:100%;height:auto;display:block;transition:transform 1s cubic-bezier(.16,1,.3,1),filter .4s}
.zev__t:hover img{transform:scale(1.05)}
.zev__more{text-align:center;display:flex;flex-direction:column;align-items:center}
.zlb{position:fixed;inset:0;z-index:300;background:rgba(8,6,4,.94);display:flex;align-items:center;justify-content:center}
.zlb[hidden]{display:none}
.zlb img{max-width:min(92vw,1300px);max-height:88vh;object-fit:contain;border-radius:10px}
.zlb button{position:absolute;background:rgba(255,255,255,.12);color:#fff;border:0;border-radius:50%;width:52px;height:52px;font-size:30px;cursor:pointer;line-height:1}
.zlb button:hover{background:#c9a24b;color:#14110d}
.zlb__x{top:20px;right:20px}.zlb__n--p{left:20px}.zlb__n--n{right:20px}
@media(max-width:900px){.zev__feat{grid-template-columns:1fr}}
.zev__grid{columns:2;column-gap:clamp(12px,1.6vw,24px)}
.zs:has(.zev__feat){padding-top:calc(var(--z-section-y) + 30px)}
@media(max-width:520px){.zev__grid{columns:1}}

/* Homepage statement: more space above */
#statement.stat{padding-top:clamp(120px,14vw,230px)!important}
.zev__collage{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:clamp(10px,1.2vw,18px);aspect-ratio:1/1.08}
.zev__collage figure{margin:0;overflow:hidden;border-radius:var(--z-r-md)}
.zev__collage img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.1s cubic-bezier(.16,1,.3,1)}
.zev__collage figure:hover img{transform:scale(1.06)}
.zev__collage .c1{grid-row:1/span 2;border-radius:var(--z-r-lg) var(--z-r-md) var(--z-r-md) var(--z-r-lg)}
.zev__collage .c2{border-radius:var(--z-r-md) var(--z-r-lg) var(--z-r-md) var(--z-r-md)}
.zev__collage .c3{border-radius:var(--z-r-md) var(--z-r-md) var(--z-r-lg) var(--z-r-md)}

/* ===== SEO / motion additions ===== */
.zs>.zdiv{position:absolute;top:0;left:var(--z-gutter);right:var(--z-gutter);height:1px;background:currentColor;opacity:.2;pointer-events:none;will-change:transform}
.zfaq__l{max-width:52rem;margin-top:8px}
.zfaq details{border-top:1px solid rgba(127,127,127,.28);padding:0}
.zfaq details:last-child{border-bottom:1px solid rgba(127,127,127,.28)}
.zfaq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0;font-size:clamp(17px,1.6vw,22px);font-weight:600;line-height:1.3}
.zfaq summary::-webkit-details-marker{display:none}
.zfaq summary::after{content:'+';font-size:28px;font-weight:300;line-height:1;transition:transform .35s cubic-bezier(.16,1,.3,1);flex:none}
.zfaq details[open] summary::after{transform:rotate(45deg)}
.zfaq details p{margin:0 0 24px;max-width:42em;line-height:1.65;opacity:.8}
.zfaq summary:focus-visible{outline:2px solid currentColor;outline-offset:4px}
.zfaq .zs__in{text-align:center}
.zfaq__l{margin-left:auto;margin-right:auto;text-align:left}
.zfaq details p{max-width:none}

.zlegal{max-width:48rem;font-size:clamp(16px,1.15vw,18px);line-height:1.75}
.zlegal h2{font-family:var(--f-display);text-transform:uppercase;font-weight:400;font-size:clamp(26px,3vw,40px);line-height:1.05;margin:2.2em 0 .6em}
.zlegal h2:first-child{margin-top:0}
.zlegal p,.zlegal li{opacity:.85}
.zlegal p{margin:0 0 1.1em}
.zlegal ul{margin:0 0 1.4em;padding-left:1.2em}.zlegal li{margin-bottom:.7em}
.zlegal a{text-decoration:underline;text-underline-offset:3px}
/* buttons: larger, easier to read */
.pill,a.pill,button.pill{font-size:15px!important;font-weight:600!important;letter-spacing:.02em!important;padding:15px 28px!important;min-height:50px;display:inline-flex;align-items:center;gap:10px}
.pill i{font-size:1.05em}
.zb1,.zb2{font-size:16px!important;font-weight:600!important;padding:14px 30px!important}
.tabs button,.ztabs button,.tb__form button,.zchips button,[data-lib]{font-size:15px}
@media(max-width:700px){.pill,a.pill,button.pill{font-size:15px!important;padding:14px 24px!important}}
/* blog posts: article column sits at the same place in every post, with or without a contents list */
@media(min-width:901px){
  .zart__grid,.zart__grid:not(:has(.ztoc)){grid-template-columns:230px minmax(0,680px)!important}
  .zart__grid:not(:has(.ztoc)) .zart__body{grid-column:2}
}
@media(max-width:900px){.zart__grid,.zart__grid:not(:has(.ztoc)){grid-template-columns:minmax(0,1fr)!important}.zart__body{grid-column:auto}}
.zart__body p,.zart__body h2,.zart__body blockquote,.zart__body ul,.zart__body ol{text-align:left}

/* ===== smooth-scroll hygiene: keep moving layers on the GPU, no layout work while scrolling ===== */
[data-parallax],[data-float],.zvideo,.reels__bgword,.about__imgs figure img,.vg__track,.zstrip__t,.zband__t{will-change:transform;backface-visibility:hidden;transform:translateZ(0)}
html{-webkit-font-smoothing:antialiased;text-rendering:optimizeSpeed}
img,video{image-rendering:auto}

/* ===== homepage kinetic bands ===== */
.zband{position:relative;z-index:1;overflow:hidden;padding-block:clamp(18px,3vw,44px);border-block:1px solid rgba(127,127,127,.18);pointer-events:none}
.zband__t{display:flex;align-items:center;gap:clamp(24px,4vw,64px);width:max-content;white-space:nowrap;font-family:var(--f-display,Anton,sans-serif);text-transform:uppercase;font-size:clamp(56px,11vw,190px);line-height:1}
.zband__t span{color:transparent;-webkit-text-stroke:1.5px currentColor}
.zband__t span:nth-of-type(even){color:inherit;-webkit-text-stroke:0}
.zband__t i{font-style:normal;font-size:.4em;opacity:.7}
.zmag{will-change:transform}

/* ===== scroll performance: no live blur, no per-frame filters, pause what is off screen ===== */
.reel__snd,.sun__card,.zb2,.liquid-glass,.zsoc,.cta__more,.lb__bg,.nav,.hero__live,.cta__when{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
.reel__snd{background:rgba(0,0,0,.6)!important}
.zb2{background:rgba(0,0,0,.35)}
.zvideo{filter:none!important}
.flow-glow{mix-blend-mode:normal!important}
.is-off,.is-off *,.is-off *::before,.is-off *::after{animation-play-state:paused!important}

/* Sunday section is now just the gatherings */
.nm__box{min-height:clamp(560px,82vh,780px)!important}

/* ===== This Sunday: live timeline ===== */
.stl{position:relative;z-index:1;background:var(--tint,#f4ecdd);color:var(--ink,#14110c);padding-block:clamp(72px,9vw,150px)}
.stl__in{max-width:var(--z-container);margin:0 auto;padding-inline:var(--z-gutter)}
.stl__head .label{opacity:.7}
.stl__title{font-family:var(--f-display);font-weight:400;text-transform:uppercase;line-height:.95;font-size:clamp(44px,7vw,112px);margin:.2em 0 .5em}
.stl__live{display:flex;flex-wrap:wrap;align-items:center;gap:clamp(16px,2.4vw,40px);padding:clamp(18px,2vw,28px) clamp(18px,2.4vw,36px);border-radius:24px;background:#14110c;color:#fff;margin-bottom:clamp(48px,6vw,96px)}
.stl__pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:99px;background:var(--z-gold,#c9a24a);color:#14110c;font-family:var(--f-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}
.stl__pill::before{content:"";width:8px;height:8px;border-radius:50%;background:#14110c;animation:stlpulse 1.6s ease-in-out infinite}
.stl__what{margin:0;font-size:clamp(18px,2vw,28px);display:flex;flex-direction:column;gap:2px}
.stl__what b{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(26px,3.2vw,48px);line-height:1}
.stl__what span{opacity:.75}
.stl__clock{display:flex;gap:clamp(8px,1vw,14px);margin-left:auto}
.stl__clock div{display:grid;justify-items:center;gap:2px;min-width:clamp(62px,6vw,92px);padding:10px 8px;border-radius:14px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16)}
.stl__clock b{font-family:var(--f-display);font-weight:400;font-size:clamp(28px,3.2vw,50px);line-height:1;font-variant-numeric:tabular-nums}
.stl__clock i{font-style:normal;font-family:var(--f-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.65}
.stl__line{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,56px);position:relative}
.stl__line::before,.stl__line::after{content:"";position:absolute;left:0;right:0;top:9px;height:2px;background:rgba(20,17,12,.18)}
.stl__line::after{background:var(--z-gold,#c9a24a);transform:scaleX(0);transform-origin:0 50%;transition:transform 1.8s cubic-bezier(.16,1,.3,1) .3s}
.stl.is-in .stl__line::after{transform:scaleX(1)}
.stl__line li{position:relative;padding-top:clamp(36px,3.6vw,52px);opacity:0;transform:translateY(34px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1)}
.stl.is-in .stl__line li{opacity:1;transform:none}
.stl.is-in .stl__line li:nth-child(2){transition-delay:.18s}.stl.is-in .stl__line li:nth-child(3){transition-delay:.36s}
.stl__dot{position:absolute;left:0;top:0;width:20px;height:20px;border-radius:50%;background:var(--tint,#f4ecdd);border:2px solid #14110c}
.stl__line li.is-next .stl__dot{background:var(--z-gold,#c9a24a);border-color:#14110c;box-shadow:0 0 0 0 rgba(201,162,74,.6);animation:stlring 2s ease-out infinite}
.stl__line li.is-done{opacity:.5!important}
.stl__line b{display:block;font-family:var(--f-display);font-weight:400;font-size:clamp(46px,5.6vw,92px);line-height:1}
.stl__line b small{font-size:.34em;letter-spacing:.08em;margin-left:4px}
.stl__line h3{margin:.5em 0 .3em;font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(20px,2vw,30px)}
.stl__line p{margin:0;max-width:30ch;line-height:1.55;opacity:.8}
.stl__line a{text-decoration:underline;text-underline-offset:3px;font-weight:600}
.stl__line li.is-next h3::after{content:"  \00b7  next";font-family:var(--f-mono);font-size:.5em;letter-spacing:.14em;color:#8a6a1f}
.stl__where{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-top:clamp(48px,6vw,90px);padding-top:clamp(20px,2vw,30px);border-top:1px solid rgba(20,17,12,.18)}
.stl__where p{margin:0;font-size:clamp(16px,1.3vw,20px)}
@keyframes stlpulse{50%{opacity:.25}}
@keyframes stlring{0%{box-shadow:0 0 0 0 rgba(201,162,74,.65)}100%{box-shadow:0 0 0 16px rgba(201,162,74,0)}}
@media(max-width:800px){
  .stl__clock{margin-left:0;width:100%}.stl__clock div{flex:1}
  .stl__line{grid-template-columns:1fr;gap:34px;padding-left:34px}
  .stl__line::before,.stl__line::after{left:9px;right:auto;top:0;bottom:0;width:2px;height:auto;transform-origin:50% 0}
  .stl__line::after{transform:scaleY(0)}.stl.is-in .stl__line::after{transform:scaleY(1)}
  .stl__line li{padding-top:0}.stl__dot{left:-34px;top:8px}
}
@media(prefers-reduced-motion:reduce){.stl__line li{opacity:1;transform:none;transition:none}.stl__line::after{transform:none;transition:none}.stl__pill::before,.stl__line li.is-next .stl__dot{animation:none}}

/* home h1 keeps the small eyebrow look (SEO: one visible h1 with the primary keyword) */
.zhc h1.zeye{font-size:13px!important;line-height:1.3;letter-spacing:.12em;font-weight:400;margin:0 0 14px;text-transform:none}
.zfacts li span b{font-weight:700}
