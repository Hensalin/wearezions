/* extras: vectors, badge, watch wall, progress */
.prog{position:fixed;left:0;right:0;top:0;height:3px;z-index:1100;pointer-events:none}
.prog i{display:block;height:100%;background:var(--red);transform:scaleX(0);transform-origin:left}
section{position:relative}
.watch{background:var(--paper);padding:clamp(70px,10vw,150px) var(--pad);overflow:hidden}
.watch__head{display:grid;gap:20px;justify-items:start;margin-bottom:clamp(32px,5vw,70px);max-width:1100px}
.watch__title{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(54px,11vw,190px);line-height:.88}
.bento{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:clamp(120px,14vw,220px);gap:clamp(10px,1.4vw,20px)}
.tile{position:relative;overflow:hidden;border-radius:18px;background:#1c1b19;cursor:pointer;grid-column:span 4;grid-row:span 2;isolation:isolate}
.tile:nth-child(1){grid-column:span 7;grid-row:span 3}
.tile:nth-child(2){grid-column:span 5;grid-row:span 3}
.tile:nth-child(5){grid-column:span 8}
.tile:nth-child(6){grid-column:span 4}
.tile img{position:absolute;inset:-8% 0;width:100%;height:116%;object-fit:cover;transition:transform 1.2s var(--ease),filter .5s}
.tile:hover img{transform:scale(1.07);filter:brightness(.85)}
.tile::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 45%,rgba(0,0,0,.82));z-index:1}
.tile__t{position:absolute;z-index:2;left:18px;right:18px;bottom:16px;color:#fff}
.tile__t small{font-family:var(--f-mono);font-size:11px;color:var(--red);letter-spacing:.06em;text-transform:uppercase}
.tile__t h3{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(20px,2.6vw,40px);line-height:1;margin-top:6px}
.tile__p{position:absolute;z-index:2;right:16px;top:16px;width:54px;height:54px;border-radius:50%;background:var(--red);color:var(--ink);display:grid;place-items:center;font-size:24px;padding-left:3px;transition:transform .5s var(--ease)}
.tile:hover .tile__p{transform:scale(1.18) rotate(-8deg)}
.tile:focus-visible{outline:3px solid var(--red);outline-offset:3px}
@media(max-width:800px){.bento{grid-template-columns:repeat(2,1fr);grid-auto-rows:clamp(110px,30vw,180px)}.tile,.tile:nth-child(n){grid-column:span 1;grid-row:span 2}.tile:nth-child(1){grid-column:span 2;grid-row:span 2}}
.hero__date{font-size:clamp(34px,6.4vw,112px);line-height:.95;right:var(--pad)}
.nav__links{gap:clamp(12px,1.8vw,30px)}.nav__links a{font-size:clamp(13px,1.15vw,16px);white-space:nowrap}

/* sharper, editorial edges (no rounded-card look) */
.reel,.film,.tile,.lb__stage{border-radius:2px}
.reel:hover{box-shadow:none}
.lb__stage{box-shadow:none}

/* gatherings · split, sticky photo + oversized times */
.gather{display:grid;grid-template-columns:5fr 7fr;gap:clamp(24px,4vw,72px);padding:clamp(80px,11vw,170px) var(--pad);background:var(--paper)}
.gather__media{position:sticky;top:96px;align-self:start;display:grid;gap:22px}
.gather__img{aspect-ratio:4/5;overflow:hidden;background:#ddd}
.gather__img img{width:100%;height:100%;object-fit:cover}
.gather__where{display:grid;gap:8px;max-width:420px}
.gather__where p{font-size:15px;line-height:1.5}
.gather__where a{font-family:var(--f-display);text-transform:uppercase;font-size:18px;color:var(--ink);border-bottom:2px solid var(--red);justify-self:start;padding-bottom:2px}
.gather__title{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(56px,9vw,150px);line-height:.88;margin:14px 0 clamp(30px,4vw,60px)}
.gather__list{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
.grow{position:relative;display:grid;grid-template-columns:auto 1fr;grid-template-areas:"n c" "t t";gap:6px 18px;padding:clamp(20px,2.6vw,36px) 0;border-bottom:1px solid var(--ink);isolation:isolate}
.grow::before{content:"";position:absolute;inset:0;background:var(--red);transform:scaleY(0);transform-origin:bottom;transition:transform .6s var(--ease);z-index:-1}
.grow:hover::before{transform:scaleY(1)}
.grow__n{grid-area:n;font-family:var(--f-mono);font-size:12px;padding-top:6px}
.grow__c{grid-area:c}
.grow__c h3{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(20px,2vw,28px)}
.grow__c p{font-size:14px;color:var(--muted);margin-top:4px}
.grow__c a{color:var(--ink);text-decoration:underline;text-underline-offset:3px}
.grow__t{grid-area:t;font-family:var(--f-display);font-weight:400;font-size:clamp(72px,12vw,200px);line-height:.85;letter-spacing:-.01em;font-variant-numeric:tabular-nums;transition:transform .6s var(--ease)}
.grow__t small{font-size:.24em;margin-left:.25em;vertical-align:top}
.grow:hover .grow__t{transform:translateX(14px)}
.grow--main .grow__t{color:var(--gold-d)}
.grow--main:hover .grow__t{color:var(--ink)}
@media(min-width:1100px){.grow{grid-template-columns:60px 1fr 1fr;grid-template-areas:"n t c";align-items:end}}
@media(max-width:900px){.gather{grid-template-columns:1fr}.gather__media{position:relative;top:0}.gather__img{aspect-ratio:16/10}}

/* featured message (latest real reel) */
.feat{all:unset;box-sizing:border-box;cursor:pointer;display:grid;grid-template-columns:110px 1fr;gap:16px;align-items:center;width:100%;max-width:440px;padding:12px;border:1px solid var(--ink);transition:background .4s var(--ease)}
.feat:hover{background:var(--red)}
.feat:focus-visible{outline:2px solid var(--gold-d);outline-offset:3px}
.feat__img{position:relative;aspect-ratio:9/16;overflow:hidden;background:var(--ink)}
.feat__img img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}
.feat:hover .feat__img img{transform:scale(1.08)}
.feat__img i{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:42px;height:42px;border-radius:50%;background:var(--red);color:var(--ink);display:grid;place-items:center;font-size:20px;padding-left:2px}
.feat__t small{font-family:var(--f-mono);font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.feat__t b{display:block;font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:24px;line-height:1.02;margin:6px 0}
.feat__t span{font-size:13px;text-decoration:underline;text-underline-offset:3px}
.footer__top{grid-template-columns:1.4fr repeat(5,1fr)}
.footer__top p{font-size:14px;line-height:1.7;opacity:.85}
@media(max-width:1100px){.footer__top{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:600px){.footer__top{grid-template-columns:1fr 1fr}.footer__brand{grid-column:1/-1}}
@media(max-width:700px){.reels__title{font-size:24vw}.reels__title sup{margin-left:.15em}}
.footer__top>*{min-width:0}.footer__top a,.footer__top p{overflow-wrap:break-word}.footer__top a[href^="mailto"]{font-size:13px}
.hero__date span{white-space:normal}
html,body{overflow-x:clip}

/* ===== SIGNAL signatures ===== */
/* warped display type */
.wl{display:inline-block;font-style:normal;will-change:transform;transform-origin:50% 60%}
/* hatched note boxes */
.note{display:inline-block;padding:12px 16px;max-width:240px;background:repeating-linear-gradient(-45deg,rgba(var(--ink-rgb),.06) 0 2px,transparent 2px 9px),var(--tint);border:1px solid var(--line);color:var(--ink)!important;font-size:13px;line-height:1.45}
.belt__hint.note{margin-left:auto;margin-right:var(--pad);display:block;width:max-content}
/* ticket band with striped stub */
.marquee--band{background:#fff;color:var(--ink);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);display:flex;align-items:stretch;padding:0}
.marquee--band .marquee__track{padding:.16em 0}
.band__stub{position:relative;z-index:2;flex:none;display:grid;align-content:center;gap:2px;padding:0 clamp(14px,2vw,28px);min-width:clamp(140px,16vw,240px);background:repeating-linear-gradient(-45deg,rgba(var(--ink-rgb),.07) 0 2px,transparent 2px 9px),var(--tint);border-right:1px dashed var(--ink);font-family:var(--f-body);text-transform:none;line-height:1.2}
.band__stub b{font-family:var(--f-display);font-weight:400;font-size:clamp(16px,1.6vw,22px)}
.band__stub span{font-size:12px;color:var(--muted)}
/* scroll-lit text */
[data-lit] .lw{opacity:.16;transition:none}
.acc{font-style:normal;color:var(--gold-d)}
/* curved belt cards + ribbon */
.bcard figure{position:relative;border-radius:46% 46% 46% 46% / 5% 5% 5% 5%}
.bcard__rib{position:absolute;left:-2%;right:-2%;bottom:6%;background:var(--red);color:var(--ink);font-family:var(--f-display);font-size:11px;letter-spacing:.06em;white-space:nowrap;overflow:hidden;padding:4px 0;transform:rotate(-3deg)}
.bcard__rib span{display:inline-block;animation:rib 14s linear infinite}
@keyframes rib{to{transform:translateX(-50%)}}
/* footer: black with warped gold type */
.footer{background:var(--ink);color:#fff;position:relative}
.footer>*:not(.footer__warp){position:relative;z-index:1}
.footer__brand img{filter:brightness(0) invert(1)}
.footer__brand p,.footer h3,.footer__legal,.footer__top p{color:rgba(255,255,255,.7)}
.footer__top a{color:#fff}
.footer__legal{border-top-color:rgba(255,255,255,.18);margin-top:clamp(40px,6vw,90px)}
.footer__warp{position:absolute;inset:0;z-index:0;display:flex;flex-direction:column;justify-content:center;gap:2vw;overflow:hidden;pointer-events:none}
.warp{font-family:var(--f-display);font-size:clamp(110px,17vw,300px);line-height:.82;white-space:nowrap;color:var(--red);opacity:.42;text-transform:uppercase;transform:scaleY(1.25)}
.warp:nth-child(2){margin-left:-12vw}
@media(prefers-reduced-motion:reduce){.bcard__rib span{animation:none}}

/* ===== LIGHT THEME everywhere ===== */
body{background:var(--paper)}
.vision{background:var(--paper-2);color:var(--ink)}
.vcard{border-color:rgba(var(--ink-rgb),.22);background:rgba(255,255,255,.55)}
.vcard p{color:var(--muted)}
.vcard__n,.vcard--intro h2 span{color:var(--gold-d)}
.vision__bar{background:rgba(var(--ink-rgb),.14)}
.vision__bar i{background:var(--gold-d)}
.reels{background:var(--paper-2);color:var(--ink)}
.reels .label,.reels__foot,.reels__lead{color:var(--muted)}
.reels__bgword{-webkit-text-stroke:1px rgba(var(--accd-rgb),.22)}
.reels__title{color:var(--ink)}
.reels__title sup{color:var(--gold-d)}
.reels__bar{background:rgba(var(--ink-rgb),.14)}
.reels__bar i{background:var(--gold-d)}
.reel,.film{border-color:rgba(var(--ink-rgb),.14);background:var(--tint)}
.reel__n{background:var(--ink);color:var(--red)}
.films__head h3{color:var(--ink)}
.tile{background:var(--tint)}
.reels .pill--light{background:var(--ink);color:#fff}.reels .pill--light:hover{background:var(--red);color:var(--ink)}
.lb__bg{background:rgba(var(--paper-rgb),.95)}
.lb__stage{box-shadow:0 40px 90px -34px rgba(var(--ink-rgb),.45)}
.lb__info{color:var(--ink)}
.lb__info h3{color:var(--ink)}
.lb__info p{color:var(--muted)}
.lb__info .label{color:var(--muted)}
.lb__info .pill--light{background:var(--ink);color:#fff}
.lb__x,.lb__nav{background:var(--ink);color:var(--red)}
.panels{background:var(--paper);color:var(--ink)}
.panel__veil{background:linear-gradient(90deg,rgba(var(--paper-rgb),.97) 0%,rgba(var(--paper-rgb),.82) 38%,rgba(var(--paper-rgb),.15) 78%),linear-gradient(0deg,rgba(var(--paper-rgb),.7),transparent 45%)}
.panel__copy p:not(.label){color:var(--muted)}
.panel .pill--light{background:var(--ink);color:#fff}.panel .pill--light:hover{background:var(--red);color:var(--ink)}
.panels__dots i{background:rgba(var(--ink-rgb),.25)}
.panels__dots i.is-on{background:var(--gold-d)}
.footer{background:var(--paper-2);color:var(--ink)}
.footer__brand img{filter:brightness(0)}
.footer__brand p,.footer h3,.footer__legal,.footer__top p{color:var(--muted)}
.footer__top a{color:var(--ink)}
.footer__top a:hover{color:var(--gold-d)}
.footer__legal{border-top-color:rgba(var(--ink-rgb),.18)}
.warp{opacity:.5}

/* ===== CONCLAVE-STYLE DESIGN LAYER (light) ===== */
.nav{inset:14px auto auto 50%;transform:translateX(-50%);width:min(980px,calc(100% - 28px));height:58px;border-radius:99px;background:rgba(255,255,255,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(var(--ink-rgb),.08);box-shadow:0 14px 44px -18px rgba(var(--ink-rgb),.3);padding:0 8px 0 24px}
.nav.is-hidden{transform:translate(-50%,-160%)}
.nav__cta{border-radius:99px;padding:11px 20px}
.menu{padding-top:100px}
.hero{background:var(--paper)}
.hero__words,.hero__tag,.hero__thumb,.hero__sub{display:none}
.hero__frame{left:0!important;right:0!important;top:0!important;bottom:0!important}
.hero__shade{background:linear-gradient(180deg,rgba(var(--ink-rgb),.28),rgba(var(--ink-rgb),.06) 40%,rgba(var(--paper-rgb),0) 62%,var(--paper) 100%)}
.hero__top{position:absolute;left:var(--pad);right:var(--pad);top:96px;display:flex;justify-content:space-between;gap:12px;font-family:var(--f-display);text-transform:uppercase;font-size:clamp(14px,1.5vw,22px);color:rgba(255,255,255,.92);letter-spacing:.02em;text-shadow:0 2px 18px rgba(0,0,0,.4)}
.hero__date{inset:0;left:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 2vw;font-size:clamp(64px,17.5vw,320px);line-height:.86;pointer-events:none}
.hero__date-l2{font-family:var(--f-body);font-weight:500;font-size:clamp(13px,1.7vw,24px)!important;letter-spacing:.04em;color:#fff!important;margin-top:clamp(14px,2vw,28px);text-shadow:0 2px 24px rgba(var(--ink-rgb),.55)}
.hero__ctawrap{position:absolute;left:0;right:0;bottom:clamp(110px,22svh,210px);display:flex;justify-content:center}
.hero__ctawrap .pill{border-radius:99px;box-shadow:0 14px 40px -14px rgba(var(--ink-rgb),.5)}
.hero__count{left:var(--pad);right:auto;bottom:clamp(18px,3svh,30px)}
.hero__live{bottom:clamp(18px,3svh,30px)}
/* statement + facts */
.stat{position:relative;padding:clamp(80px,11vw,170px) var(--pad);text-align:center;background:radial-gradient(60% 50% at 50% 0%,rgba(var(--acc-rgb),.28),transparent 70%),var(--paper);z-index:2}
.stat__big{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(34px,6.2vw,104px);line-height:1;max-width:1250px;margin:0 auto}
.stat__big .acc{color:var(--gold-d)}
.stat__row{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(14px,2vw,28px);max-width:1250px;margin:clamp(44px,6vw,90px) auto 0;text-align:left}
.stat__i{border-top:1px solid var(--ink);padding-top:16px}
.stat__i b{display:block;font-family:var(--f-display);font-weight:400;font-size:clamp(54px,7vw,120px);line-height:.9;font-variant-numeric:tabular-nums}
.stat__i span{display:block;margin-top:8px;color:var(--muted);font-size:14px}
@media(max-width:700px){.stat__row{grid-template-columns:1fr 1fr}.hero__top{top:84px}}
/* centered section headers + rounded soft cards, Conclave-style */
.belt__head,.watch__head{text-align:center;justify-items:center;margin-inline:auto}
.belt__lead{margin-inline:auto}
.belt .label,.watch .label,.reels .label,.gather .label,.program .label{color:var(--gold-d);text-transform:uppercase;letter-spacing:.08em}
.tile,.reel,.film,.gather__img,.about__imgs figure,.bcard figure,.feat,.vcard,.lb__stage{border-radius:22px}
.tile,.bcard figure,.gather__img,.about__imgs figure,.vcard{box-shadow:0 24px 60px -34px rgba(var(--ink-rgb),.4)}
.bcard figure{border-radius:22px}
.reel,.film{border:0;box-shadow:0 20px 50px -30px rgba(var(--ink-rgb),.5)}
.reel__n,.tile__p{box-shadow:none}
.watch{background:linear-gradient(180deg,var(--paper),var(--paper-2))}
.pill{border-radius:99px}

/* ===== hero image + animation ===== */
.hero__img{transform-origin:50% 60%;animation:heroZoom 22s ease-in-out infinite alternate;will-change:transform}
@keyframes heroZoom{from{transform:scale(1.04) translate3d(0,0,0)}to{transform:scale(1.16) translate3d(-1.2%,-1.5%,0)}}
.nav{animation:navIn 1.1s var(--ease) .4s backwards}
@keyframes navIn{from{opacity:0;transform:translate(-50%,-140%)}to{opacity:1;transform:translate(-50%,0)}}
.hero__glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(50% 40% at 50% 38%,rgba(var(--acc-rgb),.35),transparent 70%);mix-blend-mode:soft-light;animation:glow 7s ease-in-out infinite alternate}
@keyframes glow{from{opacity:.5}to{opacity:1}}
.hero__date-l2,.hero__top span,.hero__ctawrap,.hero__count{animation:fadeUp 1.2s var(--ease) backwards}
.hero__date-l2{animation-delay:1.5s}.hero__top span{animation-delay:1.1s}.hero__ctawrap{animation-delay:1.8s}.hero__count{animation-delay:2s}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.js .hero__date-l2,.js .hero__top span{animation:none}
/* full-bleed band */
.bleed{position:relative;height:min(86svh,820px);min-height:480px;overflow:hidden;display:grid;place-items:center;background:var(--paper-2);z-index:2}
.bleed__img{position:absolute;left:0;top:-10%;width:100%;height:120%;object-fit:cover;will-change:transform}
.bleed__veil{position:absolute;inset:0;background:linear-gradient(180deg,var(--paper) 0%,rgba(var(--paper-rgb),0) 22%,rgba(var(--ink-rgb),.18) 60%,rgba(var(--paper-rgb),0) 78%,var(--paper) 100%)}
.bleed__copy{position:relative;z-index:1;display:grid;gap:20px;justify-items:center;text-align:center;padding:0 var(--pad);max-width:1100px}
.bleed__copy .label{color:#fff}
.bleed__h{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(34px,6.4vw,104px);line-height:1;color:#fff}
@media(prefers-reduced-motion:reduce){.hero__img,.hero__glow{animation:none}}
.hero__shade{background:linear-gradient(180deg,rgba(var(--ink-rgb),.34),rgba(var(--ink-rgb),.12) 45%,rgba(var(--paper-rgb),0) 62%,var(--paper) 100%)}
.bleed__veil{background:linear-gradient(180deg,var(--paper) 0%,rgba(var(--paper-rgb),0) 20%,rgba(var(--ink-rgb),.38) 50%,rgba(var(--ink-rgb),.38) 62%,rgba(var(--paper-rgb),0) 80%,var(--paper) 100%)}

/* ===== ORIGINAL wearezion.co FONTS (Benzin + site body font), brown palette ===== */
@font-face{font-family:"Benzin";font-weight:400;font-display:swap;src:url("https://static.parastorage.com/fonts/v2/3803126a-7f49-48d7-97a1-bd25afd92eca/v1/benzin.latin.woff2") format("woff2")}
@font-face{font-family:"Benzin";font-weight:700;font-display:swap;src:url("https://static.parastorage.com/fonts/v2/e2f0c595-349c-4a78-b47e-8ec2546881ac/v1/benzin.latin.woff2") format("woff2")}
@font-face{font-family:"WAZ Body";font-weight:400;font-display:swap;src:url("https://static.wixstatic.com/ufonts/1d526c_6c7062b8fb154ce98603c9d769c033ca/woff2/file.woff2") format("woff2"),url("https://static.wixstatic.com/ufonts/1d526c_6c7062b8fb154ce98603c9d769c033ca/woff/file.woff") format("woff")}
:root{--f-display:"Benzin","Arial Black","Helvetica Neue",Arial,sans-serif;--f-body:"WAZ Body","Helvetica Neue",Arial,sans-serif;--f-mono:"WAZ Body","Helvetica Neue",Arial,sans-serif;}
.h2,h1,h2,h3{font-weight:700}
.nav__links,.nav__cta,.pill,.menu a,.label{letter-spacing:.02em}
.pill{font-size:11.1px}
.nav__links{font-size:13.32px}
.nav__cta{font-size:11.1px}
.menu a{font-size:clamp(24.2px,7.15vw,44px)}
.hero__tag{font-size:clamp(11.84px,1.18vw,16.28px)}
.hero__date{font-size:clamp(28px,5.5vw,84px)}
.hero__count b{font-size:clamp(13.32px,1.48vw,20.72px)}
/* marquees */
.marquee{font-size:clamp(17px,3.25vw,52px)}
.bcard h3{font-size:clamp(16.64px,1.66vw,24.32px)}
.prow h3{font-size:clamp(20.9px,3.3vw,52.8px)}
.ticket__main b{font-size:clamp(24.2px,2.42vw,37.4px)}
.ticket__stub{font-size:14.8px}
.vcard--intro h2{font-size:clamp(45px,7vw,115px)}
.vcard__n{font-size:clamp(45px,5vw,80px)}
.vcard h3{font-size:clamp(21.76px,2.18vw,33.28px)}
.reels__bgword{font-size:clamp(100px,21vw,360px)}
.reels__title{font-size:clamp(45px,8.5vw,145px)}
.reel__bot h3{font-size:clamp(14.8px,1.33vw,19.24px)}
.films__head h3{font-size:clamp(22px,3.5vw,55px)}
