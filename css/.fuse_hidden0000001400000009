.panel__copy h2{font-size:clamp(30px,4vw,60px)!important;line-height:1.05!important}

/* v15: About = text left, two images fill the gap on the right */
.about{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);grid-template-areas:"l i" "b i" "r i";column-gap:clamp(28px,5vw,80px);row-gap:clamp(16px,2vw,28px);align-items:start;align-content:center}
.about>.label{grid-area:l}
.about__big{grid-area:b;max-width:none;font-size:clamp(28px,3.6vw,58px)!important;line-height:1.12;letter-spacing:-.03em}
.about__row{grid-area:r;display:flex;flex-direction:column;align-items:flex-start;gap:22px}
