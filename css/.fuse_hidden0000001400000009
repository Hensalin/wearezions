/* ===== vision v4: bold colour-block bento ===== */
.vb{display:grid;grid-template-columns:repeat(6,1fr);gap:clamp(10px,1.2vw,16px);max-width:1200px;margin:0 auto}
.vb__c{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;min-height:clamp(260px,26vw,340px);padding:clamp(22px,2.4vw,36px);border-radius:6px;isolation:isolate;transition:transform .5s var(--ease)}
.vb__c:hover{transform:translateY(-6px)}
.vb__n{position:absolute;right:-.04em;top:-.12em;font-style:normal;font-family:var(--f-display);font-size:clamp(150px,19vw,270px);line-height:1;z-index:-1;-webkit-text-stroke:2px currentColor;color:transparent;opacity:.28;transition:opacity .4s,transform .6s var(--ease)}
.vb__c:hover .vb__n{opacity:.6;transform:translateX(-10px)}
.vb__c h3{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(26px,2.6vw,40px);line-height:1;margin:0 0 12px}
.vb__c p{margin:0;font-size:clamp(14.5px,1.1vw,16.5px);line-height:1.6;max-width:44ch}
.vb__b1{grid-column:span 4;background:#16130f;color:#f4ece0;min-height:clamp(300px,30vw,400px)}
.vb__b2{grid-column:span 2;background:#b8893a;color:#16130f}
.vb__b3{grid-column:span 2;background:#e9dfcf;color:#16130f}
.vb__b4{grid-column:span 2;background:#16130f;color:#f4ece0}
.vb__b5{grid-column:span 2;background:#8a5a14;color:#fff7e8}
.vb__b1 h3{font-size:clamp(34px,4vw,60px)}
@media(max-width:900px){.vb{grid-template-columns:1fr}.vb__c,.vb__b1{grid-column:auto;min-height:230px}}

/* ===== sunday: timetable instead of cards ===== */
.sch{max-width:1100px;margin:0 auto}
.sch__row{display:grid;grid-template-columns:minmax(200px,.8fr) minmax(0,1.4fr) auto;align-items:center;gap:clamp(16px,3vw,48px);padding:clamp(22px,2.6vw,38px) clamp(0px,1.5vw,24px);border-top:1px solid rgba(var(--ink-rgb),.18);transition:background .4s,padding .5s var(--ease)}
.sch__row:hover{background:rgba(var(--ink-rgb),.04)}
.sch__t{font-family:var(--f-display);font-size:clamp(52px,7vw,104px);line-height:.95;color:var(--ink);white-space:nowrap}
.sch__t small{font-family:var(--f-mono);font-size:13px;letter-spacing:.12em;margin-left:10px;color:var(--gold-d);vertical-align:top;position:relative;top:.9em}
.sch__d h3{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(22px,2.2vw,34px);line-height:1.05;margin:0 0 6px}
.sch__d p{margin:0;font-size:15px;line-height:1.6;color:var(--muted)}
.sch__tag{font-family:var(--f-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);border:1px solid rgba(var(--ink-rgb),.25);border-radius:99px;padding:8px 14px;white-space:nowrap;text-decoration:none}
.sch__tag--link{color:var(--ink);border-color:var(--gold-d)}.sch__tag--link:hover{background:var(--gold-d);color:#fff}
.sch__row--main{background:#16130f;color:#f4ece0;border-top-color:#16130f;border-radius:6px;margin:6px 0}
.sch__row--main:hover{background:#16130f}
.sch__row--main .sch__t,.sch__row--main .sch__d h3{color:#d8b06a}
.sch__row--main .sch__d p{color:rgba(244,236,224,.75)}
.sch__row--main .sch__t small{color:#f4ece0}
.sch__row--main .sch__tag{color:#f4ece0;border-color:rgba(244,236,224,.35)}
.sch__where{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:clamp(24px,2.6vw,36px) clamp(0px,1.5vw,24px) 0;border-top:1px solid rgba(var(--ink-rgb),.18)}
.sch__where p{margin:4px 0 0;font-size:16px;color:var(--ink)}
@media(max-width:800px){.sch__row{grid-template-columns:1fr;gap:10px;padding:24px 16px}.sch__tag{justify-self:start}.sch__where{flex-direction:column;align-items:flex-start;padding:24px 16px 0}}

/* sunday: restore cards, no overlap */
.sun__grid{align-items:stretch;margin-bottom:clamp(20px,2.4vw,32px)}
.sun__card{animation:none!important;translate:none!important}
.sun__where{position:relative;z-index:0;margin-top:0!important;clear:both}

/* hero: better text legibility over the bright image */
.hero__shade{background:linear-gradient(180deg,rgba(0,0,0,.62) 0%,rgba(0,0,0,.4) 30%,rgba(0,0,0,.48) 60%,rgba(0,0,0,.85) 100%)!important}
.hero__glow{background:radial-gradient(60% 50% at 50% 50%,rgba(0,0,0,.35),transparent 75%)!important}
.hero__top{color:#fff!important;font-size:clamp(16px,1.7vw,26px)!important;text-shadow:0 2px 14px rgba(0,0,0,.85),0 0 3px rgba(0,0,0,.7)}
.hero__date-l1{text-shadow:0 6px 40px rgba(0,0,0,.55)}
.hero__date-l2{color:#fff!important;font-weight:700;font-size:clamp(17px,1.7vw,26px)!important;letter-spacing:.04em;text-shadow:0 2px 16px rgba(0,0,0,.9),0 0 4px rgba(0,0,0,.75)}

/* navbar: clearer, higher-contrast text */
.nav{background:rgba(255,255,255,.97)!important}
.nav a,.nav__links a,.nav__link{color:#14110d!important;font-size:clamp(15px,1.15vw,18px)!important;letter-spacing:.03em;font-weight:400}
.nav a:hover{color:var(--gold-d)!important}
html[data-theme="dark"] .nav{background:rgba(22,19,15,.96)!important}
html[data-theme="dark"] .nav a,html[data-theme="dark"] .nav__links a{color:#f4ece0!important}
.nav__cta,.nav .pill{color:#d8b06a!important}

/* fix: navbar CTA button text was being overridden by the nav link colour */
.nav a.nav__cta{color:#d8b06a!important;background:#14110d!important;font-size:clamp(14px,1.05vw,16px)!important}
.nav a.nav__cta:hover{color:#14110d!important;background:#d8b06a!important}
html[data-theme="dark"] .nav a.nav__cta{background:#d8b06a!important;color:#14110d!important}

/* ===== responsive pass (phone / tablet / laptop / large) ===== */
html,body{max-width:100%;overflow-x:hidden}
img,video,iframe{max-width:100%}
/* hero top line wraps instead of clipping */
@media(max-width:700px){
  .hero__top{flex-direction:column!important;align-items:center;gap:2px;text-align:center;width:90vw!important;font-size:15px!important}
  .hero__top span{white-space:normal!important}
  .hero__date-l2{font-size:15px!important;padding:0 16px;bottom:clamp(110px,16svh,150px)}
  .hero__live{left:16px!important;right:auto!important;bottom:16px!important}
}
/* theme toggle never covers buttons / text */
@media(max-width:820px){.theme-toggle{width:38px;height:38px;bottom:70px;right:12px;opacity:.92}}
@media(max-width:700px){.theme-toggle{bottom:14px}}
/* footer text wraps without chopping words */
.footer a,.footer p,.footer li{overflow-wrap:break-word;word-break:normal}
.footer a[href^="mailto"]{font-size:clamp(12.5px,3.6vw,15px)}
@media(max-width:520px){.footer__mega{font-size:clamp(44px,17vw,90px)}}
/* nav stays inside the screen on small phones */
@media(max-width:520px){.nav{width:calc(100% - 20px)!important}}
/* very large screens: keep content readable */
@media(min-width:1700px){.sun__grid,.sun__where,.vb,.sch{max-width:1400px}}
/* touch devices: no stuck hover lifts */
@media(hover:none){.vb__c:hover,.sun__card:hover,.tile:hover{transform:none}}

/* ===== lighter hero: warm sand/amber image, softer overlay ===== */
.hero__img{filter:brightness(1.05) saturate(1.05)}
.hero__shade{background:linear-gradient(180deg,rgba(60,30,5,.22) 0%,rgba(60,30,5,.08) 40%,rgba(var(--paper-rgb),0) 62%,var(--paper) 100%)!important}
.hero__glow{opacity:.5}
.hero__top,.hero__date,.hero__date-l2{text-shadow:0 2px 22px rgba(70,35,5,.45)}

/* ===== remove dark shadow behind hero text ===== */
.hero__top,.hero__top span,.hero__date,.hero__date span,.hero__date-l1,.hero__date-l2,.hero__count,.hero__count b,.hero__live{text-shadow:none!important;filter:none!important}

/* ===== black shade at the bottom of the hero ===== */
.hero__shade{background:linear-gradient(180deg,rgba(0,0,0,.12) 0%,rgba(0,0,0,0) 35%,rgba(0,0,0,.18) 58%,rgba(0,0,0,.72) 100%)!important}

/* podcast panel: warm brown / orange picture */
.panel__bg img[src*="hero-banner.jpg"]{filter:none!important;object-fit:cover;object-position:50% 55%}
.panel__bg img[src*="hero-brown.jpg"]{filter:none!important;object-fit:cover;object-position:50% 60%}
.panel__bg img[src*="hero-banner-blue.jpg"]{filter:none!important;object-fit:cover;object-position:50% 60%}
.panel__bg img[src*="photo-1751536084702"]{filter:none!important;object-fit:cover;object-position:50% 55%}

/* crisp HD hero picture */
.hero__img{animation:none!important;filter:none!important;image-rendering:-webkit-optimize-contrast;image-rendering:high-quality}

