/* ===== purple theme: animated type + aurora ===== */
@keyframes gradMove{to{background-position:300% 0}}
.reels__title-t,.stat__i b,.vcard__n,.grow__t,.acc,.acc .lw,.vcard--intro h2 span{background:linear-gradient(90deg,var(--gold-d),var(--gold),var(--gold-m),var(--gold-l),var(--gold-d));background-size:300% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;animation:gradMove 7s linear infinite}
.hero__date-l2{-webkit-text-fill-color:#fff;background:none;animation:none;color:#fff!important}
.grow--main .grow__t{color:transparent}
.grow:hover .grow__t{-webkit-text-fill-color:var(--ink);animation:none}
.stat{background:radial-gradient(40% 50% at 20% 0%,rgba(var(--acc-rgb),.35),transparent 70%),radial-gradient(40% 50% at 80% 10%,rgba(var(--acc-rgb),.18),transparent 70%),var(--paper);background-size:140% 140%;animation:aurora 14s ease-in-out infinite alternate}
