.cta__when{display:flex;align-items:center;gap:16px;text-align:left;font-family:var(--f-mono);font-size:13px;color:var(--ink);line-height:1.5;background:rgba(255,255,255,.7);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:18px;padding:12px 20px 12px 12px}
