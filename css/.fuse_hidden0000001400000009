/* ===== Closing CTA — Conclave-style full-bleed video ===== */
.cta{position:relative;overflow:hidden;min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:clamp(90px,10vw,140px) var(--pad) 90px;background:var(--ink);color:var(--ink);isolation:isolate}
