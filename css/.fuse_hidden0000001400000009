.cta .pill--light{background:rgba(255,255,255,.85);color:var(--gold-dd);border:1px solid var(--line)}
.cta__bar{position:absolute;left:var(--pad);right:var(--pad);bottom:22px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-top:16px;border-top:1px solid rgba(var(--accd-rgb),.25);font-family:var(--f-mono);font-size:12px;color:var(--ink)}
