.about__imgs figure{position:absolute;margin:0!important;overflow:hidden;border-radius:22px}
.about__imgs figure:nth-child(1){left:0;top:0;width:66%;aspect-ratio:4/5}
.about__imgs figure:nth-child(2){right:0;bottom:0;width:56%;aspect-ratio:1/1;border:8px solid var(--paper);box-shadow:0 30px 60px -30px rgba(var(--ink-rgb),.5)}
