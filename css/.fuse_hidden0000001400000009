/* ===== v13: clean Sunday + Vision sections ===== */
.sun,.vis{padding:clamp(64px,8vw,120px) var(--pad);background:var(--paper)}
.vis{background:var(--paper-2)}
.sun__head,.vis__head{text-align:center;margin-bottom:clamp(28px,4vw,56px)}
.sun__title,.vis__title{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(40px,6vw,92px);line-height:1.05;margin:10px 0 0;color:var(--ink)}
.sun__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,1.6vw,24px);max-width:1200px;margin:0 auto}
.sun__card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:clamp(22px,2.4vw,36px);display:flex;flex-direction:column;gap:10px;box-shadow:0 24px 60px -40px rgba(var(--ink-rgb),.4);transition:transform .5s var(--ease),box-shadow .5s}
.sun__card:hover{transform:translateY(-6px);box-shadow:0 30px 70px -34px rgba(var(--accd-rgb),.45)}
.sun__time{font-family:var(--f-display);font-size:clamp(40px,4.4vw,64px);line-height:1.1;color:var(--gold-d)}
.sun__time small{font-family:var(--f-body);font-size:.3em;font-weight:700;letter-spacing:.1em;margin-left:4px}
.sun__card h3{font-family:var(--f-display);font-weight:400;text-transform:uppercase;font-size:clamp(20px,1.8vw,26px);margin:6px 0 0;line-height:1.1}
.sun__card p{font-size:14.5px;line-height:1.6;color:var(--muted);margin:0}
