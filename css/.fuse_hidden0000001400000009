@media(max-width:900px){.about{grid-template-columns:1fr;grid-template-areas:"l" "b" "r" "i"}.about__imgs{min-height:0;aspect-ratio:1/1.05}}

/* v16: even spacing around About / Reels */
.about{padding-top:clamp(64px,8vw,120px)!important;padding-bottom:clamp(56px,6vw,96px)!important}
.reels{padding-top:clamp(64px,8vw,120px)!important;padding-bottom:clamp(56px,6vw,96px)!important}
.reels__head{margin-bottom:clamp(28px,4vw,52px)}

/* ===== v17: animated backgrounds for Sunday + Vision ===== */
.sun,.vis{position:relative;overflow:hidden;isolation:isolate}
.sun>*,.vis>*{position:relative;z-index:1}
.sun::before,.sun::after,.vis::before,.vis::after{content:"";position:absolute;z-index:0;border-radius:50%;filter:blur(70px);pointer-events:none;will-change:transform}
.sun::before{width:46vw;height:46vw;left:-12vw;top:-10vw;background:radial-gradient(circle,rgba(var(--acc-rgb),.55),transparent 65%);animation:blobA 16s ease-in-out infinite alternate}
.sun::after{width:40vw;height:40vw;right:-10vw;bottom:-12vw;background:radial-gradient(circle,rgba(var(--acc-rgb),.32),transparent 65%);animation:blobB 19s ease-in-out infinite alternate}
.vis::before{width:44vw;height:44vw;right:-10vw;top:-8vw;background:radial-gradient(circle,rgba(var(--acc-rgb),.45),transparent 65%);animation:blobB 18s ease-in-out infinite alternate}
.vis::after{width:42vw;height:42vw;left:-12vw;bottom:-14vw;background:radial-gradient(circle,rgba(var(--acc-rgb),.35),transparent 65%);animation:blobA 21s ease-in-out infinite alternate}
@keyframes blobA{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(14vw,8vw,0) scale(1.25)}}
