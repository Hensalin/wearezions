# Copy to .env and fill in. NEVER commit .env.
# Instagram App ID / Secret: Meta App Dashboard > Instagram > API setup with Instagram login
IG_APP_ID=your-instagram-app-id
IG_APP_SECRET=your-instagram-app-secret
# Must match EXACTLY a "Valid OAuth redirect URI" saved in the Meta app
IG_REDIRECT_URI=https://api.example.com/auth/instagram/callback
# Website origin(s) allowed to call the API, comma separated (leave empty if the site is served by this server)
FRONTEND_ORIGIN=https://www.example.com
# Secret needed to open /auth/instagram (the connect page). Choose a long random string.
ADMIN_KEY=change-me-to-a-long-random-string
PORT=3000
# Where the token is stored (default ./data/token.json)
# DATA_DIR=./data
