def fname(slug): return 'blog-' + slug.replace('~-', '').replace('~', '') + '.html'
def img(i, w, h): return 'https://static.wixstatic.com/media/%s/v1/fill/w_%d,h_%d,al_c,q_85/post.jpg' % (i, w, h)
def words(slug): return sum(len(t.split()) for k, t in posts_json[slug] if k in ('p', 'h2', 'blockquote', 'li', 'verse'))
def mins(slug): return max(2, round(words(slug) / 200))
