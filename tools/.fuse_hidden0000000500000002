def inject(fn, heroidx, alt, stripidx=None):
    s = R(fn)
    a = s.index('<main id="main">'); e = s.index('</section>', a) + 10
    s = s[:e] + '\n' + hero(heroidx, alt) + s[e:]
    if stripidx is not None:
        j = s.index('<section class="zs zs--dark zcta">') if '<section class="zs zs--dark zcta">' in s else s.index('</main>')
        s = s[:j] + strip(stripidx) + '\n' + s[j:]
    open(fn, 'w', encoding='utf-8').write(s)
