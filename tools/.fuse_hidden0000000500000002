        return '<div class="zphoto" data-reveal><img loading="eager" decoding="async" data-parallax src="%s" alt="%s"></div>' % (i, alt)
    return ('<div class="zphoto" data-reveal><img loading="eager" decoding="async" referrerpolicy="no-referrer" data-parallax src="%s" alt="%s"></div>' % (gp(i, 2000), alt))
