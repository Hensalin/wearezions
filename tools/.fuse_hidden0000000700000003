def enrich(f, s):
    pat = re.compile(r'<script type="application/ld\+json">(.*?)</script>', re.S)
    m = pat.search(s)
    if not m: return s
    d = json.loads(m.group(1)); nodes = d['@graph']; name = f.split('/')[-1]
    out = []
    for n in nodes:
        if n.get('@type') == 'Church':
            x = dict(rich); x['@id'] = n['@id']; x['url'] = n['url']; out.append(x)
        elif n.get('@type') in ('WebPage', 'AboutPage', 'ContactPage', 'CollectionPage') and name in SPEAK_PAGES:
            n['speakable'] = SPEAK; out.append(n)
        else: out.append(n)
    if name in EVENT_PAGES and not any(n.get('@type') == 'Event' for n in out): out += EVENTS
    d['@graph'] = out
    return s[:m.start(1)] + json.dumps(d, ensure_ascii=False) + s[m.end(1):]

def tune_head(f, s):
    name = f.split('/')[-1]
    s = s.replace('<html lang="en"', '<html lang="en-IN"', 1)
    if 'name="geo.region"' in s: return s
    url = BASE if name == 'index.html' else BASE + f
    add = ['<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">',
           '<meta name="geo.region" content="IN-TN">', '<meta name="geo.placename" content="Thoraipakkam, Chennai">',
           '<link rel="alternate" hreflang="en-IN" href="%s">' % url, '<link rel="alternate" hreflang="x-default" href="%s">' % url]
    return re.sub(r'(<link rel="canonical"[^>]*>)', lambda m: m.group(1) + '\n' + '\n'.join(add), s, 1) if '<link rel="canonical"' in s else s

def footer_link(f, s):
    href = ('../' if f.startswith('blogs/') else '') + 'church-in-omr-chennai.html'
    if href in s and 'Church in OMR, Chennai</a>' in s: return s
    new = re.sub(r'(rel="noopener">Thoraipakkam \(OMR\) ↗</a>)', r'\1<a href="%s">Church in OMR, Chennai</a>' % href, s, 1)
    return new

