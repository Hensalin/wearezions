def fix_links(html):
    rep = [('href="#top"', 'href="index.html"'), ('href="#church-life"', 'href="church-life.html"'),
           ('href="#about"', 'href="about.html"'), ('href="#bible-plans"', 'href="index.html#bible-plans"'),
