    html = re.sub(r'<nav aria-label="Mobile">.*?</nav>', lambda m: '''<nav aria-label="Mobile">\n    <a href="church-life.html">Church life</a>\n    <a href="blog.html">Blog</a>\n    <a href="bible-plan.html">Bible plans</a>\n    <a href="index.html#reels">Reels</a>\n    <a href="https://www.youtube.com/@WeAreZion/videos" target="_blank" rel="noopener">Live ↗</a>\n    <a href="podcast.html">Podcast</a>\n    <a href="about.html">About</a>\n    <a href="missions.html">Missions</a>\n    <a href="events.html">Events</a>\n    <a href="vod.html">VOD</a>\n    <a href="links.html">Links</a>\n    <a href="contact.html">Visit</a>\n    <a href="give.html">Give</a>\n  </nav>'''.replace('\\\\n', '\\n'), html, flags=re.S)
    html = re.sub(r'<a href="(?:index\.html)?#top">Home</a>', '<a href="blog.html">Blog</a>', html)
    html = re.sub(r'<a href="(?:index\.html)?#bible-plans">Bible plans</a>', '<a href="bible-plan.html">Bible plans</a>', html)
    html = re.sub(r'<a href="(?:index\.html)?#more">Podcast</a>', '<a href="podcast.html">Podcast</a>', html)
    html = re.sub(r'<a href="https://www\.wearezion\.co/vod"[^>]*>VOD</a>', '<a href="vod.html">VOD</a><a href="links.html">Links</a>', html)
    return html


def nav_common(html):
    html = site_links(html)
    html = GIVE_RE.sub('<a href="give.html">Give</a>', html)
    html = re.sub(r'<a href="https://www\.wearezion\.co/blog"[^>]*>Blog[^<]*</a>', '<a href="blog.html">Blog</a>', html)
    html = re.sub(r'<a href="https://www\.wearezion\.co/missions"[^>]*>Missions[^<]*</a>', '<a href="missions.html">Missions</a>', html)
    return html


def mark_active(html, pg):
    return html.replace('<a href="%s">' % pg, '<a href="%s" aria-current="page">' % pg)


chrome_sub = nav_common(fix_links(chrome))
footer_sub = nav_common(fix_links(footer))


def page(fname, title, desc, body, active):
    h = head
    h = re.sub(r'<title>.*?</title>', '<title>%s | We Are Zion · Chennai</title>' % title, h, 1, flags=re.S)
    h = re.sub(r'(<meta name="description" content=")[^"]*(")', lambda m: m.group(1) + desc + m.group(2), h, 1)
    h = re.sub(r'<link rel="canonical"[^>]*>', '', h)
    out = (h + '<body class="subpage">\n' + mark_active(chrome_sub, active) + '\n<main id="main">\n' + body +
           '\n</main>\n\n' + footer_sub + '\n' + scripts + '\n' + ft_wow + '\n</body>\n</html>\n')
    open(fname, 'w', encoding='utf-8').write(out)


def fig(i, alt, cls=''):
    return '<figure class="zimg %s" data-reveal><img loading="lazy" decoding="async" referrerpolicy="no-referrer" src="%s" alt="%s"></figure>' % (cls, GP(ID[i]), alt)


def local(src, alt, cls=''):
    return '<figure class="zimg %s" data-reveal><img loading="lazy" decoding="async" src="%s" alt="%s"></figure>' % (cls, src, alt)


def pill(txt, href, cls='pill--dark', ext=True):
    t = ' target="_blank" rel="noopener"' if ext else ''
    return '<a class="pill %s" href="%s"%s>%s <i class="bi bi-arrow-up-right"></i></a>' % (cls, href, t, txt)


