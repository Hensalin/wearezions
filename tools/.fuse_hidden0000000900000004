           ('href="#gallery"', 'href="index.html#gallery"'), ('href="#cta"', 'href="contact.html"')]
    for o, n in rep:
        html = html.replace(o, n)
    return html


GIVE_RE = re.compile(r'<a href="https://www\.wearezion\.co/give"[^>]*>Give(?: ↗)?</a>')


def site_links(html):
